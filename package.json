{
  "name": "v303-mdc-generator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": "^20.19.0 || >=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headless": "playwright test --reporter=list",
    "build-only": "vite build",
    "type-check": "vue-tsc --build",
    "lint:eslint": "eslint . --fix",
    "lint:stylelint": "stylelint \"**/*.{css,vue}\" --fix",
    "lint": "run-s lint:*",
    "format": "prettier --write src/",
    "validate:schemas": "jiti scripts/validate-schemas.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@sentry/vue": "^10.22.0",
    "@vicons/ionicons5": "^0.13.0",
    "ajv": "^8.17.1",
    "ajv-formats": "^3.0.1",
    "dompurify": "^3.3.0",
    "haversine-distance": "^1.2.4",
    "html2canvas": "^1.4.1",
    "jspdf": "^3.0.3",
    "jspdf-autotable": "^5.0.2",
    "markdown-it": "^14.1.0",
    "md-editor-v3": "^6.1.0",
    "mgrs": "^2.1.0",
    "naive-ui": "^2.43.1",
    "pinia": "^3.0.3",
    "vfonts": "^0.0.3",
    "vue": "^3.5.22",
    "vue-router": "^4.5.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.56.1",
    "@sentry/vite-plugin": "^4.5.0",
    "@tsconfig/node22": "^22.0.2",
    "@types/dompurify": "^3.2.0",
    "@types/jsdom": "^27.0.0",
    "@types/markdown-it": "^14",
    "@types/node": "^24.7.2",
    "@vitejs/plugin-vue": "^6.0.1",
    "@vitest/eslint-plugin": "^1.3.17",
    "@vue/compiler-dom": "^3.5.22",
    "@vue/eslint-config-prettier": "^10.2.0",
    "@vue/eslint-config-typescript": "^14.6.0",
    "@vue/server-renderer": "^3.5.22",
    "@vue/test-utils": "^2.4.6",
    "@vue/tsconfig": "^0.8.1",
    "eslint": "^9.37.0",
    "eslint-plugin-playwright": "^2.2.2",
    "eslint-plugin-vue": "^10.5.0",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "jsdom": "^27.0.0",
    "knip": "^5.65.0",
    "lint-staged": "^16.2.4",
    "npm-run-all2": "^8.0.4",
    "playwright": "^1.56.1",
    "postcss-html": "^1.8.0",
    "prettier": "^3.6.2",
    "stylelint": "^16.25.0",
    "stylelint-config-standard-vue": "^1.0.0",
    "typescript": "^5.9.3",
    "vite": "^7.1.11",
    "vite-plugin-vue-devtools": "^8.0.2",
    "vitest": "^3.2.4",
    "vue-eslint-parser": "^10.2.0",
    "vue-tsc": "^3.1.1"
  },
  "packageManager": "yarn@4.10.3",
  "lint-staged": {
    "*.{js,ts,vue}": [
      "prettier --write"
    ]
  }
}
