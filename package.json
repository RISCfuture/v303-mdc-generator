{
  "name": "v303-mdc-generator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headless": "run-s build && CI=true playwright test --reporter=list",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force tsconfig.app.json && vue-tsc --build --force tsconfig.node.json",
    "lint:eslint": "eslint .",
    "lint:stylelint": "stylelint \"src/**/*.{css,vue}\"",
    "lint:oxlint": "oxlint -c oxlintrc.json src",
    "lint:knip": "knip",
    "lint": "pnpm run lint:eslint && pnpm run lint:stylelint && pnpm run lint:oxlint && pnpm run lint:knip",
    "format": "prettier --write .",
    "validate:schemas": "jiti scripts/validate-schemas.ts",
    "generate:samples": "GEN_SAMPLES=1 vitest run src/__tests__/tools/generateSampleMdcs.spec.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@sentry/vue": "^10.56.0",
    "@vicons/ionicons5": "^0.13.0",
    "@vueuse/core": "^14.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dompurify": "^3.4.8",
    "haversine-distance": "^1.2.4",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.8",
    "markdown-it": "^14.2.0",
    "md-editor-v3": "^6.5.1",
    "mdpdfmake": "^1.0.8",
    "mgrs": "^2.1.0",
    "naive-ui": "^2.44.1",
    "pdfmake": "^0.3.9",
    "pinia": "^3.0.4",
    "proj4": "^2.20.8",
    "vfonts": "^0.0.3",
    "vue": "^3.5.35",
    "vue-router": "^5.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pinia/testing": "^1.0.3",
    "@playwright/test": "^1.60.0",
    "@tsconfig/node22": "^22.0.5",
    "@types/dompurify": "^3.2.0",
    "@types/jsdom": "^28.0.3",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.9.1",
    "@types/pdfmake": "^0.3.3",
    "@vitejs/plugin-vue": "^6.0.7",
    "@vitest/eslint-plugin": "^1.6.19",
    "@vue/compiler-dom": "^3.5.35",
    "@vue/server-renderer": "^3.5.35",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.4.1",
    "eslint-plugin-playwright": "^2.10.4",
    "eslint-plugin-vue": "^10.9.2",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jiti": "^2.7.0",
    "jsdom": "^29.1.1",
    "knip": "^6.15.0",
    "lint-staged": "^17.0.7",
    "npm-run-all2": "^9.0.1",
    "oxlint": "^1.68.0",
    "playwright": "^1.60.0",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.3",
    "stylelint": "^17.12.0",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.60.1",
    "vite": "^8.0.16",
    "vite-plugin-csp-guard": "^4.0.1",
    "vite-plugin-pwa": "^1.3.0",
    "vite-plugin-vue-devtools": "^8.1.2",
    "vitest": "^4.1.8",
    "vue-eslint-parser": "^10.4.1",
    "vue-tsc": "^3.3.3"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "prettier --write"
    ]
  },
  "packageManager": "pnpm@11.5.1"
}
