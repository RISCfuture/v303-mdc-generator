{
  "name": "v303-mdc-generator",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=25.0.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "run-p type-check \"build-only {@}\" --",
    "preview": "vite preview",
    "test:unit": "vitest",
    "test:e2e": "playwright test",
    "test:e2e:headless": "run-s build && CI=true playwright test --reporter=list",
    "build-only": "vite build",
    "type-check": "vue-tsc --build --force tsconfig.app.json && vue-tsc --build --force tsconfig.node.json",
    "lint:eslint": "eslint .",
    "lint:stylelint": "stylelint \"src/**/*.{css,vue}\"",
    "lint:oxlint": "oxlint -c oxlintrc.json src",
    "lint:knip": "knip",
    "lint": "yarn lint:eslint && yarn lint:stylelint && yarn lint:oxlint && yarn lint:knip",
    "format": "prettier --write .",
    "validate:schemas": "jiti scripts/validate-schemas.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@sentry/vue": "^10.51.0",
    "@vicons/ionicons5": "^0.13.0",
    "@vueuse/core": "^14.3.0",
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1",
    "dompurify": "^3.4.2",
    "haversine-distance": "^1.2.4",
    "html2canvas": "^1.4.1",
    "jspdf": "^4.2.1",
    "jspdf-autotable": "^5.0.7",
    "markdown-it": "^14.1.1",
    "md-editor-v3": "^6.5.0",
    "mdpdfmake": "^1.0.8",
    "mgrs": "^2.1.0",
    "naive-ui": "^2.44.1",
    "pdfmake": "^0.3.7",
    "pinia": "^3.0.4",
    "proj4": "^2.20.8",
    "vfonts": "^0.0.3",
    "vue": "^3.5.33",
    "vue-router": "^5.0.6"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@pinia/testing": "^1.0.3",
    "@playwright/test": "^1.59.1",
    "@tsconfig/node22": "^22.0.5",
    "@types/dompurify": "^3.2.0",
    "@types/jsdom": "^28.0.1",
    "@types/markdown-it": "^14.1.2",
    "@types/node": "^25.6.0",
    "@types/pdfmake": "^0.3.2",
    "@types/proj4": "^2.19.0",
    "@vitejs/plugin-vue": "^6.0.6",
    "@vitest/eslint-plugin": "^1.6.16",
    "@vue/compiler-dom": "^3.5.33",
    "@vue/server-renderer": "^3.5.33",
    "@vue/test-utils": "^2.4.10",
    "@vue/tsconfig": "^0.9.1",
    "eslint": "^10.3.0",
    "eslint-plugin-playwright": "^2.10.2",
    "eslint-plugin-vue": "^10.9.0",
    "fake-indexeddb": "^6.2.5",
    "husky": "^9.1.7",
    "jiti": "^2.6.1",
    "jsdom": "^29.1.1",
    "knip": "^6.11.0",
    "lint-staged": "^16.4.0",
    "npm-run-all2": "^8.0.4",
    "oxlint": "^1.62.0",
    "playwright": "^1.59.1",
    "postcss-html": "^1.8.1",
    "prettier": "^3.8.3",
    "stylelint": "^17.9.1",
    "stylelint-config-standard": "^40.0.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.59.1",
    "vite": "^8.0.10",
    "vite-plugin-csp-guard": "^4.0.1",
    "vite-plugin-pwa": "^1.2.0",
    "vite-plugin-vue-devtools": "^8.1.1",
    "vitest": "^4.1.5",
    "vue-eslint-parser": "^10.4.0",
    "vue-tsc": "^3.2.7"
  },
  "resolutions": {
    "css-tree": "^3.2.1",
    "vite": "^8.0.2",
    "mgrs@npm:^2.1.0": "patch:mgrs@npm%3A2.1.0#~/.yarn/patches/mgrs-npm-2.1.0-589d3b004e.patch"
  },
  "lint-staged": {
    "*.{js,ts,vue}": [
      "prettier --write"
    ]
  },
  "packageManager": "yarn@4.14.1"
}
