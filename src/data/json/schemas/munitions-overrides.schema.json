{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://v303fg.com/schemas/munitions-overrides.schema.json",
  "title": "Munitions Overrides",
  "description": "Override properties for munitions",
  "type": "object",
  "additionalProperties": {
    "type": "object",
    "properties": {
      "name": {
        "type": "string",
        "description": "Override full display name"
      },
      "shortName": {
        "type": "string",
        "description": "Short display name for PDF display (e.g., 'Mk-82', 'AGM-65')"
      },
      "weight": {
        "type": "number",
        "description": "Override weight in pounds"
      },
      "category": {
        "type": "string",
        "enum": ["air-to-air", "air-to-ground", "fuel", "pod", "rack", "empty"],
        "description": "Override munition category"
      }
    },
    "additionalProperties": false
  }
}
