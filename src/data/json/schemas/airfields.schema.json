{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://v303fg.com/schemas/airfields.schema.json",
  "title": "Airfields Database",
  "description": "Airfield data for DCS theaters including positions, navigation aids, runways, and radio frequencies",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["name", "position", "tacan", "runways", "radio"],
    "properties": {
      "name": {
        "type": "string",
        "description": "Airfield name (e.g., 'Anapa-Vityazevo', 'Batumi')"
      },
      "position": {
        "type": "object",
        "required": ["latitude", "longitude"],
        "properties": {
          "latitude": {
            "type": "number",
            "minimum": -90,
            "maximum": 90,
            "description": "Latitude in decimal degrees"
          },
          "longitude": {
            "type": "number",
            "minimum": -180,
            "maximum": 180,
            "description": "Longitude in decimal degrees"
          },
          "elevation": {
            "type": "integer",
            "description": "Airfield elevation in feet MSL (Mean Sea Level). Sourced from DCS position.y or Open-Meteo Elevation API (Copernicus DEM 2021 GLO-90)"
          }
        },
        "description": "Airfield reference position"
      },
      "tacan": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "required": ["callsign", "channel", "band"],
            "properties": {
              "callsign": {
                "type": "string",
                "description": "TACAN callsign (e.g., 'BTM', 'KTS')"
              },
              "channel": {
                "type": "integer",
                "minimum": 1,
                "maximum": 126,
                "description": "TACAN channel number"
              },
              "band": {
                "type": "string",
                "enum": ["X", "Y"],
                "description": "TACAN band (X or Y)"
              }
            }
          }
        ],
        "description": "TACAN navigation aid (null if not available)"
      },
      "runways": {
        "type": "array",
        "items": {
          "type": "object",
          "required": ["name", "heading", "ils"],
          "properties": {
            "name": {
              "type": "string",
              "description": "Runway identifier (e.g., '12', '08', '26')"
            },
            "heading": {
              "type": "integer",
              "minimum": 0,
              "maximum": 359,
              "description": "Magnetic heading in degrees"
            },
            "length": {
              "type": "number",
              "description": "Runway length in feet"
            },
            "width": {
              "type": "number",
              "description": "Runway width in feet"
            },
            "ils": {
              "oneOf": [
                {
                  "type": "null"
                },
                {
                  "type": "object",
                  "required": ["name", "frequency", "channel", "position"],
                  "properties": {
                    "name": {
                      "type": "string",
                      "description": "ILS identifier (e.g., 'ILU', 'IKS')"
                    },
                    "frequency": {
                      "type": "string",
                      "description": "ILS frequency in MHz (string to preserve decimal precision)"
                    },
                    "channel": {
                      "type": ["integer", "null"],
                      "description": "ILS channel (if applicable)"
                    },
                    "position": {
                      "type": "object",
                      "required": ["latitude", "longitude"],
                      "properties": {
                        "latitude": {
                          "type": "number",
                          "minimum": -90,
                          "maximum": 90,
                          "description": "Latitude in decimal degrees"
                        },
                        "longitude": {
                          "type": "number",
                          "minimum": -180,
                          "maximum": 180,
                          "description": "Longitude in decimal degrees"
                        }
                      },
                      "description": "ILS transmitter position"
                    }
                  }
                }
              ],
              "description": "ILS navigation aid (null if not available)"
            }
          }
        },
        "description": "Available runways (empty array if none)"
      },
      "radio": {
        "oneOf": [
          {
            "type": "null"
          },
          {
            "type": "object",
            "required": ["frequencies"],
            "properties": {
              "callsign": {
                "type": "string",
                "description": "ATC radio callsign (e.g., 'Anapa', 'Kobuleti') as published in DCS Radio.lua"
              },
              "frequencies": {
                "type": "object",
                "description": "Facility-by-band ATC frequency matrix. Outer key = facility (ground/tower/approach/atis/etc.), inner key = band (uhf/vhfAm/vhfFm/hf). The same channel often appears under multiple facilities because DCS typically models one ATC channel covering ground+tower+approach.",
                "properties": {
                  "ground":    { "$ref": "#/definitions/bandFrequencies" },
                  "tower":     { "$ref": "#/definitions/bandFrequencies" },
                  "approach":  { "$ref": "#/definitions/bandFrequencies" },
                  "departure": { "$ref": "#/definitions/bandFrequencies" },
                  "atis":      { "$ref": "#/definitions/bandFrequencies" }
                },
                "additionalProperties": { "$ref": "#/definitions/bandFrequencies" }
              }
            },
            "additionalProperties": false,
            "description": "ATC radio matrix extracted from Mods/terrains/<map>/Radio.lua"
          }
        ]
      }
    }
  },
  "definitions": {
    "bandFrequencies": {
      "type": "object",
      "description": "Frequencies in MHz keyed by radio band",
      "properties": {
        "uhf":   { "type": "number", "minimum": 0, "description": "UHF AM frequency in MHz (225-400 MHz band)" },
        "vhfAm": { "type": "number", "minimum": 0, "description": "VHF AM frequency in MHz (~108-174 MHz band)" },
        "vhfFm": { "type": "number", "minimum": 0, "description": "VHF FM frequency in MHz (30-88 MHz band)" },
        "hf":    { "type": "number", "minimum": 0, "description": "HF AM frequency in MHz (2-30 MHz band)" }
      },
      "additionalProperties": false
    }
  }
}
