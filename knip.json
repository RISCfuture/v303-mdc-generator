{
  "$schema": "https://unpkg.com/knip@latest/schema.json",
  "entry": [
    "src/main.ts",
    "src/**/*.spec.ts",
    "scripts/**/*.{js,ts}"
  ],
  "project": ["src/**/*.{ts,vue}", "scripts/**/*.{js,ts}"],
  "ignore": [
    ".pnp.cjs",
    ".pnp.loader.mjs",
    "env.d.ts",
    "**/*.spec.ts",
    "scripts/generate-airframes.js",
    "scripts/generate-munitions.js",
    "scripts/add_airfield_elevations.py"
  ],
  "ignoreBinaries": ["run-p", "run-s"],
  "ignoreDependencies": [
    "vfonts",
    "@vue/server-renderer",
    "@vue/compiler-dom",
    "postcss-html",
    "husky",
    "lint-staged",
    "prettier",
    "stylelint",
    "vue-tsc",
    "jiti",
    "npm-run-all2",
    "vue-eslint-parser"
  ]
}
