{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "project": ["src/**/*.{ts,vue}"],
  "entry": ["src/**/__tests__/**/*.{ts,spec.ts}", "src/**/*.spec.ts"],
  "ignore": ["src/utils/markdownToPdf.ts"],
  "vite": false,
  "ignoreDependencies": [
    "vite-plugin-csp-guard",
    "vite-plugin-pwa",
    "@types/dompurify",
    "@types/markdown-it",
    "dompurify",
    "html2canvas",
    "jspdf",
    "jspdf-autotable",
    "markdown-it",
    "vfonts"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "exports": "warn",
    "types": "warn",
    "duplicates": "warn",
    "dependencies": "error",
    "unlisted": "error",
    "files": "error",
    "unresolved": "off"
  }
}
