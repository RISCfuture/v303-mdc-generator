{
  "$schema": "https://unpkg.com/knip@6/schema.json",
  "project": ["src/**/*.{ts,vue}"],
  "entry": ["src/**/__tests__/**/*.{ts,spec.ts}", "src/**/*.spec.ts"],
  "ignore": ["src/utils/markdownToPdf.ts"],
  "vite": false,
  "ignoreDependencies": [
    "vite",
    "vite-plugin-csp-guard",
    "vite-plugin-pwa",
    "@types/dompurify",
    "@types/markdown-it",
    "@vue/compiler-dom",
    "@vue/server-renderer",
    "fake-indexeddb",
    "dompurify",
    "html2canvas",
    "jspdf",
    "jspdf-autotable",
    "markdown-it",
    "vfonts",
    "eslint",
    "husky",
    "jiti",
    "lint-staged",
    "npm-run-all2",
    "oxlint",
    "playwright",
    "stylelint",
    "vue-eslint-parser",
    "vue-tsc"
  ],
  "ignoreBinaries": [
    "playwright",
    "lint-staged",
    "vite",
    "run-p",
    "vitest",
    "run-s",
    "vue-tsc",
    "eslint",
    "stylelint",
    "oxlint",
    "knip",
    "prettier",
    "jiti",
    "husky"
  ],
  "ignoreExportsUsedInFile": true,
  "rules": {
    "exports": "warn",
    "types": "warn",
    "duplicates": "warn",
    "dependencies": "error",
    "unlisted": "error",
    "files": "error",
    "unresolved": "off"
  }
}
